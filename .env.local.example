# Upstash Redis (free tier) — leaderboard shared store.
# Without these the leaderboard runs in local demo mode (single instance).
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Optional DreamDEX endpoint overrides (defaults baked in)
# NEXT_PUBLIC_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
# NEXT_PUBLIC_WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws

# Strategy Copilot (server-only; never prefix these with NEXT_PUBLIC_)
OPENROUTER_API_KEY=sk-or-v1-replace-me
OPENROUTER_MODEL=openai/gpt-5.6-luna
OPENROUTER_HTTP_REFERER=http://localhost:3111
OPENROUTER_APP_TITLE=DreamCat Strategy Copilot
